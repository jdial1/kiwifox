# Artifact build: downloads prebuilt GeckoView for this revision instead of compiling Gecko.
# We only change Kotlin/Gradle, so a full Gecko build is not needed.
ac_add_options --enable-project=mobile/android
ac_add_options --target=aarch64-linux-android
ac_add_options --enable-artifact-builds
mk_add_options MOZ_OBJDIR=./objdir-kiwifox
